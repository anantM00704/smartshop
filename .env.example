DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP (needs a Google App Password, not your normal password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional: SMS OTP via Twilio. Leave empty to send OTPs by email only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91
